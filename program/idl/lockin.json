  "types": [
    {
      "name": "Config",
      "docs": [
        "Global settings. They apply to pledges created after a change; every pledge keeps its own snapshot."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "admin",
            "type": "pubkey"
          },
          {
            "name": "pending_admin",
            "docs": [
              "Set by `transfer_admin`, takes over on `accept_admin`. Default = none pending."
            ],
            "type": "pubkey"
          },
          {
            "name": "mint",
            "docs": [
              "Token accepted for new pledges."
            ],
            "type": "pubkey"
          },
          {
            "name": "forfeit_to",
            "docs": [
              "Token account that receives forfeited deposits of new pledges."
            ],
            "type": "pubkey"
          },
          {
            "name": "min_amount",
            "type": "u64"
          },
          {
            "name": "max_amount",
            "type": "u64"
          },
          {
            "name": "paused_new",
            "type": "bool"
          },
          {
            "name": "safe_mode",
            "docs": [
              "Emergency switch: forfeits are blocked, refunds to owners are allowed."
            ],
            "type": "bool"
          },
          {
            "name": "safe_periods",
            "docs": [
              "Every safe-mode period so far (`end == 0` while it is on), oldest first."
            ],
            "type": {
              "vec": {
                "defined": {
                  "name": "SafePeriod"
                }
              }
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "CreatePledgeArgs",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "id",
            "docs": [
              "Picked by the app, unique per owner (part of the pledge address)."
            ],
            "type": "u64"
          },
          {
            "name": "amount",
            "type": "u64"
          },
          {
            "name": "days",
            "type": "u8"
          },
          {
            "name": "proof",
            "type": {
              "defined": {
                "name": "ProofKind"
              }
            }
          },
          {
            "name": "steps_per_day",
            "type": "u32"
          },
          {
            "name": "bounds",
            "docs": [
              "UTC start of every window day plus the end of the last one, in seconds (days + 2 values)."
            ],
            "type": {
              "vec": "i64"
            }
          },
          {
            "name": "tz_name",
            "type": "string"
          },
          {
            "name": "device_key",
            "type": "pubkey"
          }
        ]
      }
    },
    {
      "name": "Pledge",
      "docs": [
        "One goal with its deposit. Settled pledges are kept as history until the owner closes them."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "docs": [
              "First field, so the app can find a wallet's pledges with a memcmp at offset 8."
            ],
            "type": "pubkey"
          },
          {
            "name": "id",
            "type": "u64"
          },
          {
            "name": "version",
            "type": "u8"
          },
          {
            "name": "mint",
            "type": "pubkey"
          },
          {
            "name": "amount",
            "docs": [
              "Amount that landed in the vault at creation."
            ],
            "type": "u64"
          },
          {
            "name": "forfeit_to",
            "type": "pubkey"
          },
          {
            "name": "device_key",
            "docs": [
              "Key the app holds to check in without a wallet prompt. It can't move the deposit."
            ],
            "type": "pubkey"
          },
          {
            "name": "proof",
            "type": {
              "defined": {
                "name": "ProofKind"
              }
            }
          },
          {
            "name": "steps_per_day",
            "type": "u32"
          },
          {
            "name": "days",
            "docs": [
              "Required days (N). The window has N + 1 calendar days."
            ],
            "type": "u8"
          },
          {
            "name": "checked",
            "docs": [
              "Bit i set = calendar day i of the window was hit."
            ],
            "type": "u64"
          },
          {
            "name": "created_at",
            "type": "i64"
          },
          {
            "name": "close_at",
            "docs": [
              "End of the last day + 24h, before safe-mode extensions. Check-ins stop and forfeits start here."
            ],
            "type": "i64"
          },
          {
            "name": "status",
            "type": {
              "defined": {
                "name": "PledgeStatus"
              }
            }
          },
          {
            "name": "settled_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "vault_bump",
            "type": "u8"
          },
          {
            "name": "bounds",
            "docs": [
              "UTC start of every window day plus the end of the last one (days + 2 values, seconds)."
            ],
            "type": {
              "vec": "i64"
            }
          },
          {
            "name": "tz_name",
            "docs": [
              "Device timezone at creation, display only."
            ],
            "type": "string"
          }
        ]
      }
